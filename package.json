{
  "name": "which-nuxt",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@11.5.2",
  "description": "Detect Nuxt, Vue and Nuxt-related package versions from public Nuxt sites.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harlan-zw/which-nuxt"
  },
  "keywords": [
    "nuxt",
    "vue",
    "detect",
    "security",
    "advisory"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./modules": {
      "types": "./dist/modules/index.d.mts",
      "import": "./dist/modules/index.mjs"
    },
    "./modules/official": {
      "types": "./dist/modules/official.d.mts",
      "import": "./dist/modules/official.mjs"
    },
    "./modules/community": {
      "types": "./dist/modules/community.d.mts",
      "import": "./dist/modules/community.mjs"
    }
  },
  "bin": {
    "whichnuxt": "./dist/cli-entry.mjs",
    "which-nuxt": "./dist/cli-entry.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:attw": "attw --pack --profile esm-only",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "citty": "catalog:",
    "consola": "catalog:",
    "defu": "catalog:",
    "ofetch": "catalog:",
    "ohash": "catalog:",
    "semver": "catalog:",
    "tldts": "catalog:",
    "ufo": "catalog:",
    "ultrahtml": "catalog:",
    "unstorage": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "eslint": "catalog:",
    "obuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
